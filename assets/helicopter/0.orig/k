FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 2 -2 0 0 0 0 ];

internalField   uniform 0.01;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            uniformFixedValue;
        uniformValue    0.01;
    }

    outlet
    {
        type            zeroGradient;
    }

    sides
    {
        type            inletOutlet;
        inletValue      uniform 0.01;
        value           uniform 0.01;
    }

    "(fuselage|legs|tail|rotorCone)"
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    rotor
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    overset
    {
        type            overset;
    }
}

