FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            waveTransmissive;
        field           p;
        psi             thermo:psi;
        gamma           1.4;
        fieldInf        1e5;
        lInf            5;
        value           uniform 1e5;
    }

    sides
    {
        type            freestreamPressure;
        freestreamValue uniform 1e5;
    }

    "(fuselage|legs|tail|rotorCone)"
    {
        type            zeroGradient;
    }

    rotor
    {
        type            zeroGradient;
    }

    overset
    {
        type            overset;
    }
}

