#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory
set -e

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# rename the log file for reconstructPar.log to reconstructParMesh.log
# otherwise the reconstructPar utility will not run
# If it is not found, skip the renaming step (no need to rename)
if [ -f reconstructPar.log ]; then
    mv reconstructPar.log reconstructParMesh.log
fi


# extract mesh from archive to skip mesh generation
#tar xzf constant/polyMesh.tgz -C constant/

echo "------------------------------------"
printf "Copying initial conditions and \ndecomposing the domain\n"
echo "------------------------------------"
[ ! -d 0 ] && cp -r 0.orig 0 && decomposePar -fields
printf "\n"

echo "------------------------------------"
echo "Running the simulation"
echo "------------------------------------"
runParallel potentialFoam 
runParallel foamRun 
printf "\n"

echo "------------------------------------"
echo "Reconstructing final results"
echo "------------------------------------"
runApplication reconstructPar
printf "\n"

echo "------------------------------------"
echo "Executing post-processing"
echo "------------------------------------"
runApplication foamPostProcess -latestTime -func vorticity
printf "\n"

echo "Simulation completed successfully."

#---------
