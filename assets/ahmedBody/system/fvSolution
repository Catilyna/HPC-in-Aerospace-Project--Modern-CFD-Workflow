FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver           GAMG;
        tolerance        1e-6;
        relTol           0.1;
        smoother         GaussSeidel;
    }

    U
    {
        solver           smoothSolver;
        smoother         GaussSeidel;
        tolerance        1e-6;
        relTol           0.001;
    }

    "(k|omega)"
    {
        solver           smoothSolver;
        smoother         GaussSeidel;
        tolerance        1e-8;
        relTol           0.0; // TODO: why 0?? Isn't this slowing us down a lot??
    }
   
    Phi
    {
        $p;
    }

}

SIMPLE
{
    nNonOrthogonalCorrectors 1;

    residualControl
    {
        p               1e-3;
        U               1e-3;
        "(k|omega|h)"   1e-3;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7; // TODO: try with higher relaxation factor for U, to see if we can speed up (depends a lot on how good is our grid)
        k               0.7;
        omega           0.7;
    }
}

cache
{
    grad(U);
}

