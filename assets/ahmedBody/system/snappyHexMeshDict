FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc "caseDicts/mesh/generation/snappyHexMeshDict.cfg"

#include "${FOAM_CASE}/system/domainParams"

castellatedMesh on;
snap            on;
addLayers       on;

geometry
{

    ahmedBody
    {
        type triSurface;
        file "ahmedBody.stl";
        name ahmedBody;
        regions
        {
            body //name of STL 'solid'
            {
                name body; // name used in SHM (patch name on final mesh)
            }
            legs
            {
                name legs;
            }
        }
    }

    refinementBox
    {
        type box;
        min  $refBoxMin;  // or: ($refBoxXMin $refBoxYMin $refBoxZMin);
        max  $refBoxMax;  // or: ($refBoxXMax $refBoxYMax $refBoxZMax);
    }
    
};

// Settings for the castellatedMesh generation.
castellatedMeshControls
{

    // Refinement parameters
    // ~~~~~~~~~~~~~~~~~~~~~

    maxLocalCells 100000;

    maxGlobalCells 2000000;

    minRefinementCells 10;

    maxLoadUnbalance 0.10; // useful when dealing with pararelisation

    nCellsBetweenLevels 4; // Transition layers between two different refinements, to allow for smoother transition


    features
    (
        {
            file "ahmedBody.eMesh"; // Featured mesh to be used
            level 0; // refinement level of 4 along the features of the stl
        }

    );

    refinementSurfaces 
    {
        ahmedBody
        {
            level (0 0);

            regions
            {

                body // for each set of geometris in the stl, define a refinement level and a type of boundary (e.g: walls)
                {
                    level (4 4);
                    patchInfo
                    {
                        type wall;
                        inGroups (walls);
                    }
                }

                legs 
                {
                    level (4 4);
                    patchInfo
                    {
                        type wall;
                        inGroups (walls);
                    }
                }
            }
        }
    }

    resolveFeatureAngle 20;     // this cannot be automated, it depends on the geometry

    refinementRegions
    {
        refinementBox
        {
            mode inside;
            level     2;
        }
    }

    locationInMesh ($locInMeshX $locInMeshY $locInMeshZ); // inside point, given by the getStlDim utility
}


// Settings for the snapping.
snapControls
{
    nSmoothPatch 2;

    // relative to cell size
    tolerance 2.0;

    //- Number of mesh displacement relaxation iterations.
    nSolveIter 30;

    //- Maximum number of snapping relaxation iterations. Should stop
    //  before upon reaching a correct mesh.
    nRelaxIter 5;

    // Feature snapping

    //- Number of feature edge snapping iterations.
    //  Leave out altogether to disable.
    nFeatureSnapIter 10;

    //- Detect (geometric only) features by sampling the surface
    //  (default=false).
    implicitFeatureSnap false;

    //- Use castellatedMeshControls::features (default = true)
    explicitFeatureSnap true;

    //- Detect points on multiple surfaces (only for explicitFeatureSnap)
    multiRegionFeatureSnap false;
}


addLayersControls
{
    layers
    {
        body
        {
            nSurfaceLayers 8;
        }
        legs
        {
            nSurfaceLayers 8;
        }
    }

    relativeSizes       off;
    expansionRatio      1.12;
    firstLayerThickness 0.0005;
    minThickness        1e-3;
    maxThicknessToMedialRatio 0.6;
}

writeFlags
(
    scalarLevels
    layerFields
);

mergeTolerance 1e-6;

// ************************************************************************* //
