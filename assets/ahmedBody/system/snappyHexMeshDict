FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeEtc     "caseDicts/mesh/generation/snappyHexMeshDict.cfg"
#include        "${FOAM_CASE}/system/domainParams"
#include        "${FOAM_CASE}/system/layerParams"
#include        "${FOAM_CASE}/system/workflowParams"
castellatedMesh on;

snap            on;

addLayers       on;

geometry
{
    ahmedBody
    {
        type            triSurface;
        file            "ahmedBody.stl";
        name            ahmedBody;
        regions
        {
            body
            {
                name            body;
            }
            legs
            {
                name            legs;
            }
        }
    }
    refinementBox
    {
        type            box;
        min             $refBoxMin;
        max             $refBoxMax;
    }
}

castellatedMeshControls
{
    maxLocalCells   100000;
    maxGlobalCells  2000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.1;
    nCellsBetweenLevels $nCellsBetweenLevels;
    features        ( { file "ahmedBody.eMesh" ; level 0 ; } );
    refinementSurfaces
    {
        ahmedBody
        {
            level           ( 0 0 );
            regions
            {
                body
                {
                    level           ( $surfaceRefinementLevel $surfaceRefinementLevel );
                    patchInfo
                    {
                        type            wall;
                        inGroups        ( walls );
                    }
                }
                legs
                {
                    level           ( $surfaceRefinementLevel $surfaceRefinementLevel );
                    patchInfo
                    {
                        type            wall;
                        inGroups        ( walls );
                    }
                }
            }
        }
    }
    resolveFeatureAngle 20;
    refinementRegions
    {
        refinementBox
        {
            mode            inside;
            level           $regionRefinementLevel;
        }
    }
    locationInMesh  ( $locInMeshX $locInMeshY $locInMeshZ );
}

snapControls
{
    nSmoothPatch    2;
    tolerance       2;
    nSolveIter      30;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    layers
    {
        body
        {
            nSurfaceLayers  $nSurfaceLayers;
        }
        legs
        {
            nSurfaceLayers  $nSurfaceLayers;
        }
    }
    relativeSizes   off;
    expansionRatio  $expansionRatio;
    firstLayerThickness $firstLayerThickness;
    minThickness    0.001;
    maxThicknessToMedialRatio 0.6;
}

writeFlags      ( scalarLevels layerFields );

mergeTolerance  1e-06;

maxGlobalCells  4000000;

maxLocalCells   4000000;


