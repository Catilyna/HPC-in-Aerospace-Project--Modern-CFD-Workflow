// Time-averaged fields are written by fieldAverage at write times.
fieldAverage1
{
    type            fieldAverage;
    libs            ("libfieldFunctionObjects.so");
    writeControl    writeTime;
    timeStart       1.0; // Adjust based on when flow reaches statistical stationarity
    fields
    (
        U
        {
            mean        on;
            prime2Mean  on;
            base        time;
        }
        k
        {
            mean        on;
            base        time;
        }
    );
}

// High-Frequency Probes for Spectral Analysis (Fig. 13)
// Probe points are in the downstream wake of the single STL.
probes1
{
    type            probes;
    libs            ("libsampling.so");
    writeControl    timeStep;
    writeInterval   1;
    fields          (U);
    
    probeLocations
    (
        ( 1.20 0.10 0.0 )
        ( 1.40 0.15 0.0 )
        ( 1.60 0.05 0.0 )
        ( 1.80 0.20 0.0 )
        ( 2.00 0.10 0.0 )
    );
}

// Line sampling of the available solution fields.
velocityProfiles
{
    type            sets;
    libs            ("libsampling.so");
    writeControl    writeTime;
    setFormat       raw;
    interpolationScheme cellPoint;
    fields          (U);
    
    sets
    (
        x_H_0_139
        {
            type        lineUniform;
            axis        y;
            start       (1.20 0.001 0.0);
            end         (1.20 0.25 0.0);
            nPoints     200;
        }
        x_H_0_278
        {
            type        lineUniform;
            axis        y;
            start       (1.50 0.001 0.0);
            end         (1.50 0.25 0.0);
            nPoints     200;
        }
        x_H_0_555
        {
            type        lineUniform;
            axis        y;
            start       (2.00 0.001 0.0);
            end         (2.00 0.25 0.0);
            nPoints     200;
        }
    );
}

// Surface sampling of the available solution fields.
