// Surface extraction in VTK format for body and leg geometry patches
bodySurfaces
{
    type            surfaces;
    libs            ("libsampling.so");
    writeControl    writeTime;
    surfaceFormat   vtk;
    interpolationScheme cellPoint;
    fields          (U p);
    
    surfaces
    (
        body
        {
            type        patch;
            patches     (body);
        }
        legs
        {
            type        patch;
            patches     (legs);
        }
    );
}