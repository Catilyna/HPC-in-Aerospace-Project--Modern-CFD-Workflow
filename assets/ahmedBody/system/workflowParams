// Background mesh target cell size [m].
backgroundMeshSize       0.05;

// Number of background mesh refinement passes: 0=S, 1=M, 2=L.
nRefine                   0;

// Number of MPI subdomains. It must not exceed the available processors.
nCores                    4;

// Hard upper limit for the final mesh cell count.
maxCells                  4000000;

// Refinement controls used by snappyHexMesh and its preflight estimate.
surfaceRefinementLevel    4;
regionRefinementLevel     3;
nCellsBetweenLevels       3;

// Wall-layer target dimensionless wall distance.
targetYPlus               50;

// Representative external-flow velocity [m/s].
referenceVelocity         30;

// Fluid kinematic viscosity [m2/s].
kinematicViscosity        1.5e-05;

// Representative skin-friction coefficient [-].
skinFrictionCoefficient   0.003;

// Number of prism layers.
nSurfaceLayers            5;

// Ratio between successive layer thicknesses [-], must be greater than 1.
expansionRatio            1.2;

