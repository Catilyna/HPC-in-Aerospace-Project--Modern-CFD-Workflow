FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
#include        "${FOAM_CASE}/constant/caseSettings"

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform $turbulentNut;

boundaryField
{
    freestream
    {
        type            calculated;
        value           uniform $turbulentNut;
    }

    inlet
    {
        type            calculated;
        value           uniform $turbulentNut;
    }

    outlet
    {
        type            calculated;
        value           uniform $turbulentNut;
    }

    ground
    {
        type            nutkWallFunction;
        value           uniform $turbulentNut;
    }

    "(body|legs)"
    {
        type            nutkWallFunction;
        value           uniform $turbulentNut;
    }
}


