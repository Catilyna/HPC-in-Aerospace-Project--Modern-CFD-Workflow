FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
#include        "${FOAM_CASE}/constant/caseSettings"

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $turbulentOmega;

boundaryField
{
    freestream
    {
        type            inletOutlet;
        inletValue      uniform $turbulentOmega;
        value           uniform $turbulentOmega;
    }

    inlet
    {
        type            fixedValue;
        value           uniform $turbulentOmega;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform $turbulentOmega;
        value           uniform $turbulentOmega;
    }

    ground
    {
        type            omegaWallFunction;
        value           uniform $turbulentOmega;
    }

    "(body|legs)"
    {
        type            omegaWallFunction;
        value           uniform $turbulentOmega;
    }
}


