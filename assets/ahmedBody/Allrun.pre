#!/bin/sh
cd ${0%/*} || exit 1    # run from this directory

# Source tutorial run functions
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"
set -e

usage () {
    exec 1>&2
    while [ "$#" -ge 1 ]; do echo "$1"; shift; done
    cat <<USAGE

Usage: ${0##*/} [OPTIONS]
options:
  -c | -cores <nCores>   number of cores in parallel run
  -h | -help             help
  -m | -mesh <S|M|L|XL>  mesh size
                         - S: small, 100k cells
                         - M: medium, 1 M cells (default)
                         - L: large, 4.5M cells
  maxCells is read from system/workflowParams and is a hard upper limit
  -d | -display          reconstruct and display the final mesh in ParaView

Runs the ${PWD##*/} simulation

USAGE
    exit 1
}


refineBackgroundMesh () {

    _nRefine="$1"
    _r=0
    while [ $_r -lt "$_nRefine" ]
    do
        echo "Refining the background mesh"
        runParallel -a refineMesh -overwrite
        _r=$(( _r + 1 ))
    done
}

setKeyword () {
    _entry="$1"
    _value="$2"
    _file="$3"

    foamDictionary -entry "$_entry" -set "$_value" "$_file" > /dev/null
}

readKeyword () {
    _entry="$1"
    _file="$2"

    if ! _value=$(foamDictionary -entry "$_entry" -value "$_file")
    then
        echo "Unable to read '$_entry' from '$_file'" >&2
        return 1
    fi

    if [ -z "$_value" ]
    then
        echo "Entry '$_entry' in '$_file' must not be empty" >&2
        return 1
    fi

    printf '%s\n' "$_value"
}

checkCores () {
    case "$1" in
        ''|*[!0-9]*|0)
            echo "Number of cores must be a positive integer: '$1'" >&2
            return 1
            ;;
    esac

    _availableCores=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
    if [ "$1" -gt "$_availableCores" ]
    then
        echo "Number of cores ($1) exceeds the available processors ($_availableCores)" >&2
        return 1
    fi
}

checkPositiveInteger () {
    _name="$1"
    _value="$2"
    case "$_value" in
        ''|*[!0-9]*|0)
            echo "$_name must be a positive integer: '$_value'" >&2
            return 1
            ;;
    esac
}

checkNonNegativeInteger () {
    _name="$1"
    _value="$2"
    case "$_value" in
        ''|*[!0-9]*)
            echo "$_name must be a non-negative integer: '$_value'" >&2
            return 1
            ;;
    esac
}

checkCellBudget () {
    _nCells=$(readKeyword nCells system/domainParams)
    _backgroundCells=$(printf '%s\n' "$_nCells" | awk '
        {
            gsub(/[()]/, "")
            if (NF != 3 || $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ ||
                $3 !~ /^[0-9]+$/ || $1 == 0 || $2 == 0 || $3 == 0)
                exit 1
            print $1 * $2 * $3
        }')
    if [ "$?" -ne 0 ] || [ -z "$_backgroundCells" ]
    then
        echo "Unable to determine the background cell count from system/domainParams" >&2
        return 1
    fi

    _domainVolume=$(readKeyword domainVolume system/domainParams)
    _refinementBoxVolume=$(readKeyword refinementBoxVolume system/domainParams)
    _surfaceArea=$(readKeyword surfaceArea system/domainParams)
    _surfaceLevel=$(readKeyword surfaceRefinementLevel "$workflowDict")
    _regionLevel=$(readKeyword regionRefinementLevel "$workflowDict")
    _transitionCells=$(readKeyword nCellsBetweenLevels "$workflowDict")
    _nLayers=$(readKeyword nSurfaceLayers "$workflowDict")

    checkNonNegativeInteger surfaceRefinementLevel "$_surfaceLevel" || return 1
    checkNonNegativeInteger regionRefinementLevel "$_regionLevel" || return 1
    checkPositiveInteger nCellsBetweenLevels "$_transitionCells" || return 1
    checkNonNegativeInteger nSurfaceLayers "$_nLayers" || return 1

    _requiredCells=$_backgroundCells
    _r=0
    while [ "$_r" -lt "$nRefine" ]
    do
        _requiredCells=$(( _requiredCells * 8 ))
        _r=$(( _r + 1 ))
    done

    _estimate=$(
        awk -v base="$_requiredCells" \
            -v domain="$_domainVolume" \
            -v box="$_refinementBoxVolume" \
            -v area="$_surfaceArea" \
            -v surfaceLevel="$_surfaceLevel" \
            -v regionLevel="$_regionLevel" \
            -v transition="$_transitionCells" \
            -v layers="$_nLayers" '
            BEGIN {
                if (base <= 0 || domain <= 0 || box < 0 || area <= 0 ||
                    surfaceLevel < 0 || regionLevel < 0 ||
                    transition <= 0 || layers < 0)
                    exit 1
                baseVolume = domain / base
                cellLength = baseVolume ^ (1 / 3)
                fineLength = cellLength / (2 ^ surfaceLevel)
                boxCells = (box / baseVolume) * (8 ^ regionLevel)
                surfaceFootprint = area / (fineLength ^ 2)
                surfaceCells = surfaceFootprint * (2 * transition + 1)
                layerCells = surfaceFootprint * layers
                estimate = (base + boxCells + 0.55 * (surfaceCells + layerCells)) * 1.10
                printf "%.0f\n", estimate
            }')
    if [ "$?" -ne 0 ] || ! checkPositiveInteger "Estimated cell count" "$_estimate"
    then
        echo "Unable to estimate the final cell count from the generated mesh parameters" >&2
        return 1
    fi

    if [ "$maxCells" -lt "$_estimate" ]
    then
        echo "maxCells ($maxCells) is incompatible with the estimated final mesh" >&2
        echo "Estimated final cell count before snappyHexMesh: $_estimate" >&2
        return 1
    fi

    if [ "$maxCells" -lt "$nCores" ]
    then
        echo "maxCells ($maxCells) must be at least nCores ($nCores)" >&2
        return 1
    fi

    echo "Cell budget: max $maxCells, estimated final count $_estimate"
}

checkFinalCellCount () {
    _actualCells=$(awk '$1 == "cells:" {print $2; exit}' log.checkMesh)
    if ! checkPositiveInteger "Final cell count" "$_actualCells"
    then
        echo "Unable to read the final cell count from log.checkMesh" >&2
        return 1
    fi

    if [ "$_actualCells" -gt "$maxCells" ]
    then
        echo "Generated mesh has $_actualCells cells, exceeding maxCells ($maxCells)" >&2
        return 1
    fi

    echo "Generated mesh has $_actualCells cells (maximum $maxCells)"
}


#- Defaults are read from one user-editable case dictionary.
workflowDict=system/workflowParams
nRefine=$(readKeyword nRefine "$workflowDict")
nCores=$(readKeyword nCores "$workflowDict")
maxCells=$(readKeyword maxCells "$workflowDict")
backgroundMeshSize=$(readKeyword backgroundMeshSize "$workflowDict")
targetYPlus=$(readKeyword targetYPlus "$workflowDict")
referenceVelocity=$(readKeyword referenceVelocity "$workflowDict")
kinematicViscosity=$(readKeyword kinematicViscosity "$workflowDict")
skinFrictionCoefficient=$(readKeyword skinFrictionCoefficient "$workflowDict")
nSurfaceLayers=$(readKeyword nSurfaceLayers "$workflowDict")
expansionRatio=$(readKeyword expansionRatio "$workflowDict")
display=false;
checkNonNegativeInteger nRefine "$nRefine" || usage
checkPositiveInteger maxCells "$maxCells" || usage
checkCores "$nCores" || usage

while [ "$#" -gt 0 ]
do
   case "$1" in
   -c | -cores)
      [ "$#" -ge 2 ] || usage "'$1' option requires an argument"
      nCores=$2
      checkCores "$2" || usage
      shift 2
      setKeyword numberOfSubdomains "$nCores" system/decomposeParDict
      ;;

   -h | -help)
      usage
      ;;

   -m | -mesh)
      [ "$#" -ge 2 ] || usage "'$1' option requires an argument"
      mesh=$2
      shift 2
      case "$mesh" in
          S)  nRefine=0;;
          M)  nRefine=1;;
          L)  nRefine=2;;
          *)  usage "Invalid argument '$mesh' to -m|-mesh <S|M|L>." ;;
      esac
      ;;
   -d | -display)
      display=true
      shift
      ;;
   -test)
      shift
      ;;
   -*)
      usage "Invalid option '$1'"
      ;;
   *)
      break
      ;;
    esac
done

checkNonNegativeInteger nRefine "$nRefine" || usage
checkPositiveInteger maxCells "$maxCells" || usage
checkCores "$nCores" || usage


[ ! -d 0 ] && cp -r 0.orig 0

#- calculate the wall-layer parameters from the workflow input dictionary
runApplication calculateWallLayers \
    "$targetYPlus" \
    "$referenceVelocity" \
    "$kinematicViscosity" \
    "$skinFrictionCoefficient" \
    "$nSurfaceLayers" \
    "$expansionRatio"

#- validate STL geometry before proceeding with the workflow
runApplication surfaceCheck constant/geometry/ahmedBody.stl

#- extract STL dimensions
runApplication getStlDim constant/geometry/ahmedBody.stl "$backgroundMeshSize"

#- reject cell budgets that cannot accommodate the requested background mesh
checkCellBudget || exit 1

#- let snappyHexMesh use the full budget for refinement while retaining all
#- configured quality controls
setKeyword maxGlobalCells "$maxCells" system/snappyHexMeshDict
setKeyword maxLocalCells "$maxCells" system/snappyHexMeshDict

#- create the background mesh
runApplication blockMesh

#- generate the .eMesh file
runApplication surfaceFeatures

#- set number of subdomains
setKeyword numberOfSubdomains "$nCores" system/decomposeParDict;

#- decompose the background domain for parallel calculation
runApplication decomposePar -copyZero

#- refine the decomposed background mesh in parallel
refineBackgroundMesh "$nRefine"

#- mesh in parallel (overwrites by default)
runParallel snappyHexMesh
    
# clean unused files
rm -rf cellLevel level0Edge pointLevel surfaceIndex \
   sets constant/extendedFeatureEdgeMesh
    
runParallel checkMesh
checkFinalCellCount

runApplication reconstructPar -constant > log.reconstructParMesh 2>&1

if $display
then
    paraFoam -builtin
fi
