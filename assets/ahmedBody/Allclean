#!/bin/sh
cd "${0%/*}" || exit 1    # Run from this directory

# Source tutorial clean functions
. "$WM_PROJECT_DIR/bin/tools/CleanFunctions"

# Delete the following:
# - time directories
# - constant/polyMesh directory
# - postProcessing and VTK directories
# - log files
# - field files with a ".orig" backup
cleanCase

rm -rf validation/segregated \
    validation/*.png validation/*.eps \
    0 \
    report/images \
    pythonScripts/__pycache__

# Delete report files generated by makePdf.sh while preserving report.tex.
rm -f report/report.pdf report/report.aux report/report.log \
    report/report.out report/report.toc case.foam


# Delete problemFaces created by the checkSurfare utility (if it exists)
rm -f problemFaces

# Delete the system/domainParams file created by the getStlDim utility (if it exists)
rm -f system/domainParams system/layerParams
rm -f system/meshParams
